# FCFS Scheduling (Non-Preemptive)

process = ["P1", "P2", "P3", "P4"]
arrival = [0, 1, 2, 3]
burst = [5, 3, 8, 6]

n = len(process)

completion = []
waiting = []
turnaround = []

time = 0

for i in range(n):
    if time < arrival[i]:
        time = arrival[i]

    time += burst[i]
    completion.append(time)

    tat = completion[i] - arrival[i]
    turnaround.append(tat)

    wt = tat - burst[i]
    waiting.append(wt)

# Display Result
print("\nFCFS Scheduling")
print("-" * 50)
print("Process\tAT\tBT\tCT\tTAT\tWT")
print("-" * 50)

for i in range(n):
    print(f"{process[i]}\t{arrival[i]}\t{burst[i]}\t{completion[i]}\t{turnaround[i]}\t{waiting[i]}")

avg_wt = sum(waiting) / n
avg_tat = sum(turnaround) / n

print("\nAverage Waiting Time =", avg_wt, "ms")
print("Average Turnaround Time =", avg_tat, "ms")

# Gantt Chart
print("\nGantt Chart:")
print("0", end="")

for i in range(n):
    print(f" | {process[i]} | {completion[i]}", end="")

print()
