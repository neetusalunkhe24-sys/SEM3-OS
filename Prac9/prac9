def lru(reference_string, frames):
    memory = []
    hits = 0
    misses = 0

    for page in reference_string:
        if page in memory:
            hits += 1

            # Move recently used page to the end
            memory.remove(page)
            memory.append(page)

        else:
            misses += 1

            if len(memory) < frames:
                memory.append(page)
            else:
                # Remove least recently used page
                memory.pop(0)
                memory.append(page)

    return hits, misses


