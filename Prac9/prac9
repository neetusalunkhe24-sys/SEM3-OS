def fifo_page_replacement(pages, frames):
    memory = []
    hits = 0
    misses = 0

    print("\n===== FIFO PAGE REPLACEMENT =====")

    for page in pages:

        if page in memory:
            hits += 1
            status = "Hit"

        else:
            misses += 1
            status = "Miss"

            if len(memory) < frames:
                memory.append(page)
            else:
                memory.pop(0)
                memory.append(page)

        print("Page", page, "->", memory, ":", status)

    return hits, misses


def lru_page_replacement(pages, frames):
    memory = []
    hits = 0
    misses = 0

    print("\n===== LRU PAGE REPLACEMENT =====")

    for page in pages:

        if page in memory:
            hits += 1
            status = "Hit"

            # Move the recently used page to the end
            memory.remove(page)
            memory.append(page)

        else:
            misses += 1
            status = "Miss"

            if len(memory) < frames:
                memory.append(page)
            else:
                # Remove least recently used page
                memory.pop(0)
                memory.append(page)

        print("Page", page, "->", memory, ":", status)

    return hits, misses

